{
  "name": "@lufs/workchain",
  "version": "0.1.0",
  "description": "Agent-first CLI for LUFS audio processing workchain",
  "keywords": [
    "audio",
    "lufs",
    "normalization",
    "ffmpeg",
    "music-production",
    "sound-design",
    "agent"
  ],
  "license": "MIT",
  "author": "LUFS Audio",
  "type": "module",
  "bin": {
    "workchain": "./bin/workchain.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "execa": "^8.0.0",
    "conf": "^12.0.0",
    "globby": "^14.0.0",
    "split2": "^4.2.0"
  },
  "devDependencies": {
    "vitest": "^1.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run test && npm run lint"
  },
  "files": [
    "bin/",
    "commands/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
