{
  "extends": "agents/tsconfig",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["worker-configuration.d.ts", "env.d.ts", "src/**/*.ts", "test/**/*.ts"]
}
